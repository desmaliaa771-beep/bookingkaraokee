<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Judul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 KARAOKE CERIA"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Nama -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pelanggan"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nama"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Pilihan Ruangan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jenis Ruangan"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerRuangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Lama Sewa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lama Sewa (Jam)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtLamaSewa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 3"
            android:inputType="number"
            android:layout_marginBottom="20dp" />

        <!-- Tombol Hitung -->
        <Button
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HITUNG TOTAL"
            android:layout_marginBottom="12dp" />

        <!-- Hasil -->
        <TextView
            android:id="@+id/txtHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasil pembayaran akan muncul di sini"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Tombol Reset -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESET" />

    </LinearLayout>

</ScrollView>